# Supabase Configuration
# These values can be found in your Supabase Dashboard -> Project Settings -> API

# The URL of your Supabase project (e.g., https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=your_project_url_here

# The anon/public key for your Supabase project
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# NOTE: NEVER commit your actual .env or .env.local file to GitHub!
# Use Vercel's Environment Variables settings to provide these values in production.
