# Copy to `.env.local` and fill in values. Never commit `.env.local`.
# Required — Supabase project credentials (Supabase dashboard → Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Required — canonical site URL used for metadata, sitemap/robots and OAuth redirects.
# Current production/preview deployment: https://obsidian-league.vercel.app
# After a custom domain is purchased and connected, set this to https://<your-domain>
# (see DEPLOY.md §7 - switching to a custom domain). No trailing slash needed; the
# login form appends `/auth/callback` automatically.
# Local development may keep http://localhost:3000 — an empty value falls back to it.
NEXT_PUBLIC_SITE_URL=https://obsidian-league.vercel.app

# Optional — automatically set by Vercel; used as an OAuth redirect fallback in the login
# form when NEXT_PUBLIC_SITE_URL is unset.
# NEXT_PUBLIC_VERCEL_URL=

# ---------------------------------------------------------------------------
# Team registration channels (home-page "Ready to Prove Yourself?" banner).
# The banner opens WhatsApp / the organisers' inbox with the message template documented
# in FESO.md, prefilled with the active tournament's name, dates and host city.
# Leave a value empty to hide that button; if BOTH are empty the banner links to /news
# instead so it can never be a dead link.
# ---------------------------------------------------------------------------
# Digits only, international format, no leading "+" (test number: 15551234567).
NEXT_PUBLIC_REGISTRATION_WHATSAPP=15551234567
# Registration inbox that receives team entries (test inbox).
NEXT_PUBLIC_REGISTRATION_EMAIL=entries@example.com

# ---------------------------------------------------------------------------
# Sentry — error + performance monitoring (optional; the app runs without it).
# Free tier friendly default: 10% of successful transactions are sampled,
# 100% of unhandled errors are always captured. Leave the DSN empty to disable.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# 0.1 = 10% of performance transactions. Lower it (0.05) if you approach quota.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Session Replay is off by default — it consumes quota quickly. 'true' to enable.
NEXT_PUBLIC_SENTRY_REPLAYS=false
# Only needed to upload readable stack traces during builds (paid/CI usage).
# Generate a token at: sentry.io → your org → Settings → API → Personal Access Tokens
# Token needs "project:write" scope.
# SENTRY_AUTH_TOKEN=
# Your Sentry organisation slug (e.g. "my-org")
# SENTRY_ORG=
# The Sentry project slug (auto-created when you enter a DSN)
# SENTRY_PROJECT=

# ---------------------------------------------------------------------------
# Upstash Redis — shared cache + global rate limiting (optional).
# Free tier: keep the cached reads to heavy, semi-static data only (articles,
# medal tallies, team directory, configuration). Live scores are not cached.
#
# Create a free database at upstash.com → Redis → Create Database → copy the REST URL
# and token into the fields below.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Upstash Redis — Realtime pub/sub fallback (PAID TIER).
# When Supabase Realtime hits its 5-connection free-tier limit, new clients fall
# back to listening on this Redis channel instead of failing outright.
#
# How it works:
#   1. Every admin write (score, clock, event, fixture update) triggers both:
#      POST /api/revalidate   (busts Next.js ISR cache)
#      POST /api/realtime-pub  (publishes the change to Redis)
#   2. Public pages subscribe to the Redis channel via the edge handler at
#      /api/realtime-sub which streams changes as Server-Sent Events.
#   3. When the Supabase connection count exceeds 5, the client auto-switches.
#
# To enable:
#   - Set UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN above.
#   - Subscribe to the free tier at https://upstash.com/products/redis
#     (free: 10 MB data store, 10k operations/day).
#     Paid: $5/mo起步 for 1M ops/day, scales linearly.
#   - Add these env vars to Vercel:
#       UPSTASH_REALTIME_CHANNEL=obsidian-realtime   (channel name, any string)
# ---------------------------------------------------------------------------
# UPSTASH_REALTIME_CHANNEL=obsidian-realtime
